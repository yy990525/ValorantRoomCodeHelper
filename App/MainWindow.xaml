<Window x:Class="ValorantHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI" Style="{StaticResource ChromeWindow}" Icon="Assets/app.ico" Title="无畏契约抢码助手" Width="1360" Height="920" MinWidth="1040" MinHeight="690" WindowStartupLocation="CenterScreen">
  <Grid Margin="14,8,14,0">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/app.png" Width="36" Height="36" Margin="0,0,12,0"/><TextBlock Text="无畏契约抢码助手" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><Border Background="{DynamicResource BadgeBg}" CornerRadius="5" Padding="9,4" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="本地识别" Style="{StaticResource Label}"/></Border></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ThemeButton" Content="切换浅色" Click="Theme_Click" Margin="0,0,8,0" Padding="12,7"/><Button Content="本地试用" Click="Demo_Click" Margin="0,0,8,0" Padding="12,7" ToolTip="打开本地动态视频，测试识别流程"/><Button Content="设置" Click="Settings_Click" Padding="14,7"/></StackPanel>
    </Grid>
    <Grid x:Name="NavigationBar" Grid.Row="1" Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="←" Click="Back_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="刷新" Click="Reload_Click" Margin="0,0,8,0"/></StackPanel><TextBox x:Name="UrlBox" Grid.Column="1" ToolTip="输入抖音直播链接" KeyDown="UrlBox_KeyDown"/><Button Grid.Column="2" Content="打开直播间" Click="Navigate_Click" Margin="10,0,0,0"/></Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="580"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340" MinWidth="300" MaxWidth="440"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="VideoTitle" Text="抖音直播" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border x:Name="PureBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SuccessBg}" CornerRadius="12" Padding="12,5" Visibility="Collapsed"><TextBlock Text="弹幕及聊天已隐藏" Foreground="{DynamicResource Success}" FontSize="12"/></Border></Grid>
          <Grid x:Name="PlayerHost" Grid.Row="1" Background="{DynamicResource VideoBg}" ClipToBounds="True">
            <wv:WebView2 x:Name="Browser" />
            <Grid x:Name="SelectionLayer" Visibility="Collapsed" Background="{DynamicResource VideoBg}"><Image x:Name="SelectionImage" Stretch="Fill"/><Canvas x:Name="SelectionCanvas" Background="Transparent" MouseLeftButtonDown="Selection_Down" MouseMove="Selection_Move" MouseLeftButtonUp="Selection_Up"><Border x:Name="SelectionBorder" BorderBrush="{DynamicResource Success}" BorderThickness="2" Background="#184AE6A1" Visibility="Collapsed" IsHitTestVisible="False"/></Canvas><Border x:Name="SelectionInstruction" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#DD111B29" CornerRadius="6" Padding="15,9" Margin="16" IsHitTestVisible="False"><TextBlock Text="拖动框选房间码所在位置 · Esc 取消" Foreground="{DynamicResource AccentText}" FontSize="13"/></Border></Grid>
          </Grid>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center"><Button x:Name="SelectButton" Content="▣  框选识别区域" Click="Select_Click" IsEnabled="False" Margin="0,0,8,4"/><Button x:Name="ReturnButton" Content="←  返回网页" Click="Return_Click" Margin="0,0,10,4" Visibility="Collapsed"/><TextBlock x:Name="RegionLabel" Text="全视频范围 · 无需框选" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,4"/></WrapPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="5" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="12"><StackPanel><Grid Margin="0,0,0,8"><TextBlock Text="识别控制" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StateLabel" Text="●  未开始" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid><Border Background="{DynamicResource Surface}" CornerRadius="5" Padding="0" Margin="0,0,0,6"><StackPanel><CheckBox x:Name="FullVideoCheck" Margin="0,3" Content="全画面自动识别（无需框选）" Click="Mode_Click"/></StackPanel></Border><Button x:Name="ToggleButton" Content="▶  开始识别" Style="{StaticResource Primary}" Height="42" FontSize="17" Click="Toggle_Click" IsEnabled="False"/><TextBlock x:Name="RecognitionHint" Text="播放直播后直接开始，全画面模式无需框选" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="最新房间码" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LatestCode" Text="------" FontFamily="Consolas" FontSize="42" FontWeight="Bold" Margin="0,6,0,4"/><TextBlock x:Name="CopyStatus" Text="等待房间码" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LatestTime" Text="来源：游戏画面" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="CopyButton" Grid.Column="1" Content="再次复制" Click="Copy_Click" IsEnabled="False" Padding="10,5"/></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="游戏填入" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="AutoFillCheck" Margin="0,4" Content="识别后自动填入游戏" Click="QuickSetting_Click"/><WrapPanel><Button x:Name="BindGameButton" Content="绑定游戏输入框" Click="BindGame_Click" Padding="10,7" Margin="0,0,6,0"/><Button x:Name="FillButton" Content="填入最新码" Click="Fill_Click" Padding="10,7"/></WrapPanel><TextBlock x:Name="GameTargetLabel" Text="打开游戏加入房间窗口后绑定位置" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,4"/><TextBlock Text="保持加入窗口打开，填入后自行确认。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,6"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="12"><StackPanel><Grid><TextBlock Text="识别自检与预览" FontSize="17" FontWeight="SemiBold"/><Button Content="自检" Click="Preflight_Click" HorizontalAlignment="Right" Padding="10,4"/></Grid><TextBlock x:Name="PreflightStatus" Text="检查播放、取帧与识别范围" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,6"/><Border Background="{DynamicResource VideoBg}" Height="64" CornerRadius="5"><Image x:Name="RegionPreview" Stretch="Uniform"/></Border><TextBlock x:Name="PreviewLabel" Text="尚未取帧" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="12"><Expander Header="更多设置" Foreground="{DynamicResource Text}"><StackPanel><CheckBox x:Name="AutoCopyCheck" Content="自动复制" Click="QuickSetting_Click"/><CheckBox x:Name="SoundCheck" Content="提示音" Click="QuickSetting_Click"/><CheckBox x:Name="TopmostCheck" Content="窗口置顶" Click="QuickSetting_Click"/><CheckBox x:Name="StableCheck" Content="连续两次确认" Click="QuickSetting_Click"/><TextBlock Text="格式：AAA000 · 区分大小写" Style="{StaticResource Label}" Margin="0,8,0,0"/></StackPanel></Expander></Border>
          <Border Style="{StaticResource Card}" Padding="12"><StackPanel><Grid Margin="0,0,0,10"><TextBlock Text="最近记录" FontSize="17" FontWeight="SemiBold"/><Button Content="清空" Click="ClearHistory_Click" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/></Grid><TextBlock x:Name="EmptyHistory" Text="识别成功后，记录会显示在这里" Style="{StaticResource Label}" Margin="0,8"/><ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" MaxHeight="195" MouseDoubleClick="History_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,7"/><Setter Property="ToolTip" Value="双击复制这个房间码"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusBar" Text="正在初始化浏览器…" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HotkeyLabel" Grid.Column="1" Text="F8 开始 / 暂停    F9 复制最新码" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
  </Grid>
</Window>
